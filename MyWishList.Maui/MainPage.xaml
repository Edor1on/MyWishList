<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyWishList.Maui.MainPage"
             Title="Мої Бажання">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Створити нову ціль" 
               FontSize="22" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- Поле вводу зв'язане зі змінною NewWishName у ViewModel -->
        <Entry Placeholder="Напр., вивчити патерни проєктування..." 
               Text="{Binding NewWishName}" 
               FontSize="16" />

        <!-- Кнопка зв'язана з командою AddWishCommand -->
        <Button Text="Додати бажання" 
                Command="{Binding AddWishCommand}" 
                BackgroundColor="#512BD4" 
                TextColor="White"
                CornerRadius="8"
                FontAttributes="Bold"/>

        <BoxView HeightRequest="1" Color="LightGray" Margin="0,15" />

        <Label Text="Твій список:" 
               FontSize="18" 
               FontAttributes="Bold" />

        <!-- Список, який бере дані з колекції Wishes -->
        <CollectionView ItemsSource="{Binding Wishes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5,0,5" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="True">
                        <VerticalStackLayout>
                            <!-- Беремо властивість Name з нашого класу Wish -->
                            <Label Text="{Binding Name}" 
                                   FontSize="16" 
                                   FontAttributes="Bold" />

                            <!-- Беремо властивість Status -->
                            <Label Text="{Binding Status}" 
                                   FontSize="12" 
                                   TextColor="Gray" 
                                   Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>

</ContentPage>