<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyWishList.Maui.MainPage"
             x:Name="RootPage"
             Title="Мої Цілі">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

        <Label Text="Створити нову ціль" 
               FontSize="22" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Entry Placeholder="Напр., вивчити патерни проєктування..." 
               Text="{Binding NewGoalName}" 
               FontSize="16" />

        <Button Text="Додати ціль" 
                Command="{Binding AddGoalCommand}" 
                BackgroundColor="#512BD4" 
                TextColor="White"
                CornerRadius="8"
                FontAttributes="Bold"/>

        <BoxView HeightRequest="1" Color="LightGray" Margin="0,15" />

        <Label Text="Твій список:" 
               FontSize="18" 
               FontAttributes="Bold" />

        <CollectionView ItemsSource="{Binding Goals}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5,0,5" CornerRadius="10" BorderColor="#E0E0E0" HasShadow="True">
                        <VerticalStackLayout>

                            <!-- Верхня частина: Назва, Статус та кнопка видалення -->
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" 
                                           FontSize="16" 
                                           FontAttributes="Bold" />

                                    <Label Text="{Binding Status}" 
                                           FontSize="12" 
                                           TextColor="Gray" 
                                           Margin="0,5,0,0"/>
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="❌"
                                        BackgroundColor="Transparent"
                                        TextColor="Red"
                                        FontSize="20"
                                        Padding="10"
                                        Command="{Binding BindingContext.DeleteGoalCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                            </Grid>

                            <!-- Роздільник -->
                            <BoxView HeightRequest="1" Color="#EEEEEE" Margin="0,10" />

                            <!-- Прогрес та коментарі -->
                            <Label Text="{Binding ProgressPercentage, StringFormat='Прогрес: {0:F0}%'}" 
                                   FontSize="14" 
                                   FontAttributes="Bold" />

                                <Slider Minimum="0" Maximum="100" 
                                   Value="{Binding ProgressPercentage, Mode=TwoWay}" 
                                   MinimumTrackColor="#512BD4" />

                                <Entry Placeholder="Нотатки чи статус..." 
                                   Text="{Binding Impression}" 
                                   FontSize="14" 
                                   Margin="0,5,0,10" />

                            <!-- Кнопка збереження прогресу -->
                            <Button Text="💾 Зберегти прогрес"
                                    BackgroundColor="#28A745"
                                    TextColor="White"
                                    HeightRequest="35"
                                    Padding="5"
                                    CornerRadius="8"
                                    Command="{Binding BindingContext.UpdateGoalCommand, Source={x:Reference RootPage}}"
                                    CommandParameter="{Binding .}" />

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>